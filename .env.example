# Public site configuration. Copy to .env.local for local development.
# All values are public (NEXT_PUBLIC_); no credentials belong in this repository.

# Canonical portfolio origin (no trailing slash).
NEXT_PUBLIC_PORTFOLIO_URL=https://portfolio-indradev.vercel.app

# Technical blog origin used for the latest-writing feed and blog links.
NEXT_PUBLIC_BLOG_URL=https://blog-indra.vercel.app

# Public contact email shown in the footer.
NEXT_PUBLIC_CONTACT_EMAIL=mahadiindra2@gmail.com

# Public profile links shown in the footer.
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/mahadiindra182/
NEXT_PUBLIC_GITHUB_URL=https://github.com/indra-182
